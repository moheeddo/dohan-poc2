# KHNP Education AI Platform - Environment Variables (v10)
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
# cp .env.example .env && vi .env

# === Upstage API ===
UPSTAGE_API_KEY=your_upstage_api_key_here

# === AtomicGPT (선택 — 하이브리드 라우터 활성화) ===
# docker compose --profile with-atomic up 으로 함께 기동
# ATOMIC_GPT_API_KEY=your_atomic_gpt_key_here
# ATOMIC_GPT_BASE_URL=http://atomic-gpt:8000/v1

# === 온프레미스 URL (Docker 내부 네트워크) ===
# UPSTAGE_BASE_URL=http://solar-llm:8000/v1   # docker-compose에서 자동 설정
# CHROMADB_URL=http://chromadb:8000

# === 웹 포트 ===
WEB_PORT=80
WEB_SSL_PORT=443

# === 로깅 ===
LOG_LEVEL=INFO

# === Grafana (모니터링 프로파일) ===
# docker compose --profile monitoring up
GRAFANA_PASSWORD=khnp2026
